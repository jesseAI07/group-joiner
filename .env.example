# Google Sheet ID = the long string in the sheet URL between /d/ and /edit
SHEET_ID=
# From your service account JSON key
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: regex a valid student ID must match (default: 5-15 letters/digits)
ID_PATTERN=^[A-Za-z0-9]{5,15}$
